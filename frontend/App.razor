<header class="site-header">
    <div class="site-header-inner">
        <div class="warehouse-brand">
            <span class="warehouse-mark" aria-hidden="true"></span>
            <span>Склад техники</span>
        </div>
        <nav class="site-nav" aria-label="Разделы склада">
            <NavLink href="" Match="NavLinkMatch.All">Позиции</NavLink>
            <NavLink href="catalogs" Match="NavLinkMatch.All">Справочники</NavLink>
        </nav>
    </div>
</header>

<main class="main-content">
    <Router AppAssembly="typeof(App).Assembly">
        <Found Context="routeData">
            <RouteView RouteData="routeData" />
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </Found>
    </Router>
</main>
