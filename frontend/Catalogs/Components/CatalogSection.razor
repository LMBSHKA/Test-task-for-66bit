@using Warehouse.Frontend.Shared
@using Warehouse.Frontend.Shared.Components

<section class="data-panel" aria-labelledby="@SectionId">
    <div class="catalog-heading">
        <h2 id="@SectionId">@Title</h2>
        <button type="button" class="dialog-button button-primary" @onclick="() => OpenEditor(null)">@AddLabel</button>
    </div>

    @if (loadFailed)
    {
        <div class="load-state">
            <p role="alert">Не удалось загрузить справочник.</p>
            <button type="button" class="retry-button" @onclick="LoadAsync">Повторить</button>
        </div>
    }
    else if (entries is null)
    {
        <p class="load-state" role="status">Загрузка…</p>
    }
    else if (entries.Count == 0)
    {
        <p class="load-state" role="status">@EmptyMessage</p>
    }
    else
    {
        <div class="data-table-scroll" role="region" aria-labelledby="@SectionId" tabindex="0">
            <table class="data-table catalog-table" aria-labelledby="@SectionId">
                <thead>
                    <tr>
                        <th scope="col">Наименование</th>
                        <th scope="col">Описание</th>
                        <th scope="col">Дата создания</th>
                        <th scope="col">Дата обновления</th>
                        <th scope="col">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in entries)
                    {
                        <tr @key="entry.Id">
                            <th scope="row">@entry.Name</th>
                            <td class="description-cell">@(string.IsNullOrWhiteSpace(entry.Description) ? "—" : entry.Description)</td>
                            <td class="date-cell">@DisplayFormat.Date(entry.CreatedAt)</td>
                            <td class="date-cell">@DisplayFormat.Date(entry.UpdatedAt)</td>
                            <td>
                                <div class="row-actions">
                                    <button type="button" class="row-action" aria-label="@($"Изменить «{entry.Name}»")"
                                            @onclick="() => OpenEditor(entry)">Изменить</button>
                                    <button type="button" class="row-action row-delete" aria-label="@($"Удалить «{entry.Name}»")"
                                            @onclick="() => pendingDeletion = entry">Удалить</button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@if (editorOpen)
{
    <CatalogEntryDialog Kind="Kind" Entry="editedEntry" Title="@EditorTitle"
                        OnSaved="AfterSaveAsync" OnCancel="CloseEditor" />
}

@if (pendingDeletion is { } deletion)
{
    <ConfirmDeleteDialog ItemName="@deletion.Name" DeleteAsync="token => Catalogs.DeleteAsync(Kind, deletion.Id, token)"
                         OnDeleted="AfterDeleteAsync" OnCancel="CloseDelete" />
}
